<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.RetryQueue.Sample.MainPage"
             Title="Failed-operation retries">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Label Text="Plugin.Maui.RetryQueue" FontSize="22" FontAttributes="Bold" />
            <Label Text="Failed API → 30s / 2min / 10min → success or dead letter"
                   TextColor="Gray" />

            <Label x:Name="SnapshotLabel" FontSize="13" LineBreakMode="WordWrap" />

            <Label Text="Enqueue failed operations" FontAttributes="Bold" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Register customer" Clicked="OnCustomerClicked" />
                <Button Text="Submit order" Clicked="OnOrderClicked" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Telemetry" Clicked="OnTelemetryClicked" />
                <Button Text="Poison (dead letter)" Clicked="OnPoisonClicked" />
            </HorizontalStackLayout>

            <Label Text="Queue" FontAttributes="Bold" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Drain now" Clicked="OnDrainClicked" />
                <Button Text="Replay dead letters" Clicked="OnReplayClicked" />
            </HorizontalStackLayout>

            <Label Text="Operations" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label x:Name="OperationsLabel" FontFamily="Courier New" FontSize="12" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
